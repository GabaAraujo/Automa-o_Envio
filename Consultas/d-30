DECLARE @Inicio DATETIME;
DECLARE @Fim    DATETIME;

SET @Inicio = DATEFROMPARTS(
    YEAR(DATEADD(MONTH, -1, GETDATE())),
    MONTH(DATEADD(MONTH, -1, GETDATE())),
    16
);

SET @Fim = DATEFROMPARTS(
    YEAR(GETDATE()),
    MONTH(GETDATE()),
    16
);

SELECT
    b.data                          AS data_vistoria,
    b.hora                          AS hora_vistoria,
    b.id_tipo_operacao,
    CASE b.id_tipo_operacao
        WHEN 52    THEN N'INSTALAÇÃO'
        WHEN 49    THEN N'DESINSTALAÇÃO'
        WHEN 57    THEN N'MANUTENÇÃO'
        WHEN 75397 THEN N'RETIRADA'
        ELSE CAST(b.id_tipo_operacao AS VARCHAR(20))
    END                             AS tipo_operacao,
    b.placa                         AS TAG,
    v.placa_veiculo                 AS placa_veiculo,
    v.tecnico_executante_1,
    v.tecnico_executante_2,
    v.tecnico_executante_3,
    b.vistoriador_uf                AS estado,
    b.cliente                       AS cliente,
    b.url_download                  AS url_download,
    b.nome_veiculo                  AS veiculo,
    v.tipo_de_contrato              AS tipo_contrato,
    v.tipo_equipamento              AS tipo_equipamento

FROM BMCLIENTES.dbo.valores_dinamicos v
INNER JOIN BMCLIENTES.dbo.BdVexSoft b
    ON v.id_bdvexsoft = b.id

WHERE
    -- ✅ INTERVALO: >= 16 mês anterior  E  <= 15 mês atual
    b.data >= @Inicio
    AND b.data <  @Fim
   
    AND v.tipo_equipamento = N'Caminhão Comboio'
