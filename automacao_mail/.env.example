# Copie para .env e preencha (não commite o .env).
# Documentação: CONTEXTO.md

# SQL Server (opção A: string completa)
# MSSQL_ODBC_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...;

# SQL Server (opção B: campos separados)
MSSQL_SERVER=
MSSQL_DATABASE=BMCLIENTES
MSSQL_USER=
MSSQL_PASSWORD=
# MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Pasta dos .xlsx (opcional; padrão: automacao_mail/saida/)
# REPORT_OUTPUT_DIR=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# MAIL_CC=
# MAIL_BCC=
# MAIL_ATTACH_EXTRA=
